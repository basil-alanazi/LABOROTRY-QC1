VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Push notifications (shift reminders) — set these in Vercel's Environment
# Variables settings, NOT here. VAPID_PUBLIC_KEY is already hardcoded in
# pushNotifications.js since public VAPID keys are meant to be public.
# VAPID_PUBLIC_KEY=BG1GixDqBtaS_l5ZCEtdp31H7NFkzHtN_h4ZErPbO5g3Yy5UlxV3psvqE3dUxJhj9zsdWdDsuluiL2tUJKcTbR0
# VAPID_PRIVATE_KEY=RaaL7rf8liudETk4xKAqTxFLS6gJ7OYlBh-kxgo641A

# Optional email OTP at login (api/send-otp.js, api/verify-otp.js) — also
# set these in Vercel, not here. Only needed once someone adds an email in
# "My profile"; login stays username+password only until then.
# SUPABASE_SERVICE_ROLE_KEY=  (Supabase project settings → API → service_role key)
# RESEND_API_KEY=             (from resend.com)
# RESEND_FROM_EMAIL=QC Log <onboarding@resend.dev>  (optional, needs a verified domain in Resend for production use)

